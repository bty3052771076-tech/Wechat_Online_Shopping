<view class="page">
  <view class="toolbar">
    <t-button size="small" theme="primary" bind:tap="onAdd">+ 新建优惠券</t-button>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">暂无优惠券</view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="card {{item.status === 0 ? 'card-off' : ''}}">
      <view class="card-header">
        <view class="card-title">{{item.couponName}}</view>
        <view class="card-badge">{{item.typeLabel}}</view>
      </view>
      <view class="card-body">
        <view class="meta-row"><text class="meta-label">面值:</text><text class="meta-value">{{item.valueDesc}}</text></view>
        <view class="meta-row"><text class="meta-label">门槛:</text><text class="meta-value">满{{item.minAmount}}元可用</text></view>
        <view class="meta-row"><text class="meta-label">有效期:</text><text class="meta-value">{{item.startTime ? item.startTime : '—'}} ~ {{item.endTime ? item.endTime : '—'}}</text></view>
        <view class="meta-row"><text class="meta-label">库存:</text><text class="meta-value">{{item.totalQuantity === 0 ? '不限' : item.totalQuantity}} / 已领{{item.receivedQuantity}}</text></view>
        <view class="meta-row"><text class="meta-label">状态:</text><text class="meta-value {{item.status === 1 ? 'on' : 'off'}}">{{item.statusLabel}}</text></view>
      </view>
      <view class="card-footer">
        <t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="onEdit">编辑</t-button>
        <t-button size="small" theme="danger" variant="outline" data-id="{{item.id}}" bind:tap="onDelete">下架</t-button>
      </view>
    </view>
  </view>

  <!-- 编辑/新建弹层 -->
  <t-popup visible="{{showDialog}}" placement="bottom" bind:visible-change="onCancel">
    <view class="dialog">
      <view class="dialog-title">{{isAdd ? '新建优惠券' : '编辑优惠券'}}</view>
      <view class="form-row">
        <text class="form-label">名称*</text>
        <t-input value="{{formData.couponName}}" data-field="couponName" bind:change="onFormInput" placeholder="优惠券名称" />
      </view>
      <view class="form-row">
        <text class="form-label">类型*</text>
        <t-radio-group value="{{formData.couponType}}" data-field="couponType" bind:change="onFormInput">
          <t-radio value="1">满减券</t-radio>
          <t-radio value="2">折扣券</t-radio>
        </t-radio-group>
      </view>
      <view class="form-row">
        <text class="form-label">面值*</text>
        <t-input value="{{formData.discountValue}}" data-field="discountValue" bind:change="onFormInput" placeholder="满减填元数，折扣填折率如0.8" type="digit" />
      </view>
      <view class="form-row">
        <text class="form-label">门槛(元)</text>
        <t-input value="{{formData.minAmount}}" data-field="minAmount" bind:change="onFormInput" placeholder="0表示无门槛" type="digit" />
      </view>
      <view class="form-row">
        <text class="form-label">库存(0不限)</text>
        <t-input value="{{formData.totalQuantity}}" data-field="totalQuantity" bind:change="onFormInput" type="number" />
      </view>
      <view class="form-row">
        <text class="form-label">有效天数*</text>
        <t-input value="{{formData.validDays}}" data-field="validDays" bind:change="onFormInput" type="number" />
      </view>
      <view class="form-row">
        <text class="form-label">开始日期*</text>
        <t-input value="{{formData.startTime}}" data-field="startTime" bind:change="onFormInput" placeholder="YYYY-MM-DD" />
      </view>
      <view class="form-row">
        <text class="form-label">结束日期*</text>
        <t-input value="{{formData.endTime}}" data-field="endTime" bind:change="onFormInput" placeholder="YYYY-MM-DD" />
      </view>
      <view class="dialog-footer">
        <t-button variant="outline" bind:tap="onCancel">取消</t-button>
        <t-button theme="primary" bind:tap="onSave">保存</t-button>
      </view>
    </view>
  </t-popup>
</view>
