<view class="page">
  <view class="toolbar">
    <t-button size="small" theme="primary" bind:tap="onAdd">+ 新建Banner</t-button>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">暂无Banner</view>

  <view class="list">
    <view wx:for="{{list}}" wx:key="id" class="card {{item.status === 0 ? 'card-off' : ''}}">
      <t-image src="{{item.imageUrl}}" t-class="banner-img" mode="aspectFill" />
      <view class="card-body">
        <view class="card-title">{{item.title}}</view>
        <view class="meta-row"><text class="meta-label">排序:</text><text class="meta-value">{{item.sortOrder}}</text></view>
        <view class="meta-row" wx:if="{{item.linkValue}}"><text class="meta-label">跳转:</text><text class="meta-value">{{item.linkValue}}</text></view>
        <view class="meta-row"><text class="meta-label">有效期:</text><text class="meta-value">{{item.startTime ? item.startTime : '不限'}} ~ {{item.endTime ? item.endTime : '不限'}}</text></view>
        <view class="meta-row"><text class="meta-label">状态:</text><text class="meta-value {{item.status === 1 ? 'on' : 'off'}}">{{item.statusLabel}}</text></view>
      </view>
      <view class="card-footer">
        <t-button size="small" variant="outline" data-id="{{item.id}}" bind:tap="onEdit">编辑</t-button>
        <t-button size="small" theme="danger" variant="outline" data-id="{{item.id}}" bind:tap="onDelete">隐藏</t-button>
      </view>
    </view>
  </view>

  <t-popup visible="{{showDialog}}" placement="bottom" bind:visible-change="onCancel">
    <view class="dialog">
      <view class="dialog-title">{{isAdd ? '新建Banner' : '编辑Banner'}}</view>
      <view class="form-row">
        <text class="form-label">标题*</text>
        <t-input value="{{formData.title}}" data-field="title" bind:change="onFormInput" placeholder="Banner标题" />
      </view>
      <view class="form-row">
        <text class="form-label">图片URL*</text>
        <t-input value="{{formData.imageUrl}}" data-field="imageUrl" bind:change="onFormInput" placeholder="https://..." />
      </view>
      <view class="form-row">
        <text class="form-label">跳转路径</text>
        <t-input value="{{formData.linkValue}}" data-field="linkValue" bind:change="onFormInput" placeholder="/pages/..." />
      </view>
      <view class="form-row">
        <text class="form-label">排序值</text>
        <t-input value="{{formData.sortOrder}}" data-field="sortOrder" bind:change="onFormInput" type="number" />
      </view>
      <view class="form-row">
        <text class="form-label">开始日期</text>
        <t-input value="{{formData.startTime}}" data-field="startTime" bind:change="onFormInput" placeholder="YYYY-MM-DD (可不填)" />
      </view>
      <view class="form-row">
        <text class="form-label">结束日期</text>
        <t-input value="{{formData.endTime}}" data-field="endTime" bind:change="onFormInput" placeholder="YYYY-MM-DD (可不填)" />
      </view>
      <view class="dialog-footer">
        <t-button variant="outline" bind:tap="onCancel">取消</t-button>
        <t-button theme="primary" bind:tap="onSave">保存</t-button>
      </view>
    </view>
  </t-popup>
</view>
