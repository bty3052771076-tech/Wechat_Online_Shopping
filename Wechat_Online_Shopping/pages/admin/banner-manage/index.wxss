.page { padding: 20rpx; background: #f5f5f5; min-height: 100vh; }
.toolbar { margin-bottom: 20rpx; }
.empty { text-align: center; color: #999; padding: 60rpx 0; }
.list { display: flex; flex-direction: column; gap: 20rpx; }
.card { background: #fff; border-radius: 16rpx; overflow: hidden; }
.card-off { opacity: 0.5; }
.banner-img { width: 100%; height: 200rpx; display: block; }
.card-body { padding: 20rpx; }
.card-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 12rpx; }
.meta-row { display: flex; margin-bottom: 8rpx; }
.meta-label { font-size: 24rpx; color: #999; width: 100rpx; }
.meta-value { font-size: 24rpx; color: #333; flex: 1; }
.on { color: #07c160; }
.off { color: #999; }
.card-footer { display: flex; gap: 16rpx; justify-content: flex-end; padding: 0 20rpx 20rpx; }
.dialog { padding: 40rpx 30rpx; background: #fff; border-radius: 24rpx 24rpx 0 0; max-height: 80vh; overflow-y: auto; }
.dialog-title { font-size: 34rpx; font-weight: bold; text-align: center; margin-bottom: 30rpx; }
.form-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #666; width: 160rpx; flex-shrink: 0; }
.dialog-footer { display: flex; gap: 20rpx; margin-top: 30rpx; }
.dialog-footer t-button { flex: 1; }
